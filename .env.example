# Node.js 启动时读取；Docker Compose 用于配置变量。
PORT=8790
HOST=127.0.0.1
ROUTE_DATA_DIR=./data
ROUTE_ADMIN_USERNAME=admin

# 本机 HTTP 保持 false；通过 HTTPS 代理访问时必须 true。
ROUTE_HTTPS=false

# 可选的 HTTPS 部署使用，替换成已经解析到服务器的真实域名。
ROUTE_DOMAIN=app.example.com

# 首次启动默认生成随机密码，保存到数据目录的 admin-login.txt。
# 原生 Node 启动如需自定密码，可在本地 .env 添加 ROUTE_ADMIN_PASSWORD。
# Docker 配置默认自动生成；不要提交 .env 或管理员登录文件。
